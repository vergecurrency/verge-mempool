[Unit]
Description=Verge explorer indexer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=verge-explorer
Group=verge-explorer
ExecStart=/opt/verge-explorer/current/bin/electrs -vv --network=mainnet --daemon-dir=/var/lib/verge --daemon-rpc-addr=127.0.0.1:20102 --db-dir=/var/lib/verge-explorer/index --jsonrpc-import --http-addr=127.0.0.1:3001 --electrum-rpc-addr=127.0.0.1:60001 --monitoring-addr=127.0.0.1:14224 --main-loop-delay=500
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=262144
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/verge-explorer
UMask=0027

[Install]
WantedBy=multi-user.target
