[Unit]
Description=Verge testnet explorer indexer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=verge-explorer
Group=verge-explorer
ExecStart=/opt/verge-explorer-testnet/current/bin/electrs -vv --network=testnet --daemon-dir=/var/lib/verge --daemon-rpc-addr=127.0.0.1:20104 --db-dir=/var/lib/verge-explorer-testnet/index --jsonrpc-import --http-addr=127.0.0.1:3011 --electrum-rpc-addr=127.0.0.1:60011 --monitoring-addr=127.0.0.1:14225 --main-loop-delay=500
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=262144
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/verge-explorer-testnet
UMask=0027

[Install]
WantedBy=multi-user.target
